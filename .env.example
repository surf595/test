# ===============================
# pdm_bot: psychodynamic RAG assistant
# Скопируйте этот файл в .env и заполните значения.
# ===============================

# Telegram bot token (обязательно)
TELEGRAM_TOKEN=

# OpenAI API key (обязательно)
OPENAI_API_KEY=

# Chat model for final responses
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding model for retrieval
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536

# Qdrant connection
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=pdm_library

# Chat ID владельца (опционально, для owner-only команд)
OWNER_CHAT_ID=

# Auto-sync cadence (seconds)
AUTO_SYNC_SECONDS=120

# Retrieval depth
TOP_K=6

# Chunking settings
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# Max context size passed to LLM
MAX_CONTEXT_CHARS=12000

# Batch sizes for indexing/embedding
UPSERT_BATCH_SIZE=32
EMBED_BATCH_SIZE=32

# Number of recent messages kept in dialogue memory
MEMORY_MESSAGES_LIMIT=12
